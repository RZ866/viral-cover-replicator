{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/viral-cover-replicator/shooting-report.schema.json",
  "title": "爆款封面复刻器拍摄报告",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_info", "source_images", "image_observations", "composition", "camera_position", "lighting", "scene_and_props", "colors_and_editing", "visual_strengths", "shooting_preparation", "replication_steps", "scene_diagrams", "comparison_results", "correction_actions", "original_shooting_plans", "originality_review", "limitations"],
  "properties": {
    "project_info": {"$ref": "#/$defs/project"},
    "source_images": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/image"}},
    "image_observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "composition": {"$ref": "#/$defs/analysisBlock"},
    "camera_position": {"$ref": "#/$defs/camera"},
    "lighting": {"$ref": "#/$defs/lighting"},
    "scene_and_props": {"$ref": "#/$defs/scene"},
    "colors_and_editing": {"$ref": "#/$defs/analysisBlock"},
    "visual_strengths": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "shooting_preparation": {"$ref": "#/$defs/preparation"},
    "replication_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "scene_diagrams": {"$ref": "#/$defs/diagramData"},
    "comparison_results": {"type": ["array", "null"], "maxItems": 3, "items": {"$ref": "#/$defs/comparison"}},
    "correction_actions": {"type": ["array", "null"], "maxItems": 3, "items": {"$ref": "#/$defs/comparison"}},
    "original_shooting_plans": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/plan"}},
    "originality_review": {"type": ["object", "null"], "additionalProperties": false, "required": ["conclusion", "evidence", "improvements"], "properties": {"conclusion": {"enum": ["差异充分", "有一定差异，但仍需加强", "差异不足，建议重新设计", "图片信息不足，无法判断"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/claim"}}, "improvements": {"type": "array", "items": {"type": "string"}}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "project": {"type": "object", "additionalProperties": false, "required": ["name", "version", "mode", "created_at", "status"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"const": "1.0.0"}, "mode": {"enum": ["A", "B", "C", "D", "E"]}, "created_at": {"type": "string", "minLength": 10}, "status": {"enum": ["analysis", "waiting_for_shoot", "correction", "original_design", "complete"]}}},
    "image": {"type": "object", "additionalProperties": false, "required": ["id", "role", "path", "caption"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "role": {"enum": ["reference", "replication", "original"]}, "path": {"type": ["string", "null"]}, "caption": {"type": "string"}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["type", "statement", "evidence", "confidence"], "properties": {"type": {"enum": ["OBSERVATION", "INFERENCE", "RECOMMENDATION", "UNKNOWN"]}, "statement": {"type": "string", "minLength": 1}, "evidence": {"type": ["string", "null"]}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}},
    "analysisBlock": {"type": "object", "additionalProperties": false, "required": ["summary", "claims"], "properties": {"summary": {"type": "string"}, "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}}},
    "camera": {"type": "object", "additionalProperties": false, "required": ["summary", "angle_range", "distance_range", "starting_zoom", "focus", "exposure", "tripod", "timer", "claims"], "properties": {"summary": {"type": "string"}, "angle_range": {"type": ["string", "null"]}, "distance_range": {"type": ["string", "null"]}, "starting_zoom": {"type": ["string", "null"]}, "focus": {"type": "string"}, "exposure": {"type": "string"}, "tripod": {"type": "boolean"}, "timer": {"type": "boolean"}, "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}}},
    "lighting": {"type": "object", "additionalProperties": false, "required": ["summary", "main_direction", "softness", "shadow_direction", "fill", "low_cost_setup", "claims"], "properties": {"summary": {"type": "string"}, "main_direction": {"enum": ["left", "right", "front", "back", "top", "unknown"]}, "softness": {"enum": ["soft", "medium", "hard", "unknown"]}, "shadow_direction": {"enum": ["left", "right", "front", "back", "down", "unknown"]}, "fill": {"type": ["string", "null"]}, "low_cost_setup": {"type": "array", "items": {"type": "string"}}, "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}}},
    "bbox": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "minimum": 0.01, "maximum": 1}, "height": {"type": "number", "minimum": 0.01, "maximum": 1}}},
    "prop": {"type": "object", "additionalProperties": false, "required": ["name", "purpose", "position"], "properties": {"name": {"type": "string"}, "purpose": {"type": "string"}, "position": {"$ref": "#/$defs/bbox"}}},
    "scene": {"type": "object", "additionalProperties": false, "required": ["background", "surface", "subject", "props", "required_props", "optional_props", "substitutes"], "properties": {"background": {"type": "string"}, "surface": {"type": "string"}, "subject": {"$ref": "#/$defs/bbox"}, "props": {"type": "array", "items": {"$ref": "#/$defs/prop"}}, "required_props": {"type": "array", "items": {"type": "string"}}, "optional_props": {"type": "array", "items": {"type": "string"}}, "substitutes": {"type": "array", "items": {"type": "string"}}}},
    "preparation": {"type": "object", "additionalProperties": false, "required": ["equipment", "required_props", "optional_props", "low_cost_substitutes", "checklist"], "properties": {"equipment": {"type": "array", "items": {"type": "string"}}, "required_props": {"type": "array", "items": {"type": "string"}}, "optional_props": {"type": "array", "items": {"type": "string"}}, "low_cost_substitutes": {"type": "array", "items": {"type": "string"}}, "checklist": {"type": "array", "items": {"type": "string"}}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["order", "title", "action", "method", "purpose", "expected", "check", "common_error"], "properties": {"order": {"type": "integer", "minimum": 1}, "title": {"type": "string"}, "action": {"type": "string"}, "method": {"type": "string"}, "purpose": {"type": "string"}, "expected": {"type": "string"}, "check": {"type": "string"}, "common_error": {"type": "string"}}},
    "diagramData": {"type": "object", "additionalProperties": false, "required": ["subject", "camera", "light", "reflector", "props", "camera_height", "subject_height", "camera_angle"], "properties": {"subject": {"$ref": "#/$defs/bbox"}, "camera": {"$ref": "#/$defs/bbox"}, "light": {"$ref": "#/$defs/bbox"}, "reflector": {"$ref": "#/$defs/bbox"}, "props": {"type": "array", "items": {"$ref": "#/$defs/prop"}}, "camera_height": {"type": "number", "minimum": 0}, "subject_height": {"type": "number", "minimum": 0}, "camera_angle": {"type": "number", "minimum": 0, "maximum": 90}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["priority", "difference", "possible_cause", "action", "verification"], "properties": {"priority": {"type": "integer", "minimum": 1, "maximum": 3}, "difference": {"type": "string"}, "possible_cause": {"type": "string"}, "action": {"type": "string"}, "verification": {"type": "string"}}},
    "plan": {"type": "object", "additionalProperties": false, "required": ["id", "name", "theme", "intensity", "scenario", "visual_goal", "borrowed_principles", "differences", "props", "background", "composition", "lighting", "camera", "parameters", "steps", "substitutes", "failure_causes", "acceptance", "diagram"], "properties": {"id": {"enum": ["A", "B", "C"]}, "name": {"type": "string"}, "theme": {"type": "string"}, "intensity": {"enum": ["轻度", "中度", "深度"]}, "scenario": {"type": "string"}, "visual_goal": {"type": "string"}, "borrowed_principles": {"type": "array", "items": {"type": "string"}}, "differences": {"type": "array", "minItems": 3, "items": {"type": "string"}}, "props": {"type": "array", "items": {"type": "string"}}, "background": {"type": "string"}, "composition": {"type": "string"}, "lighting": {"type": "string"}, "camera": {"type": "string"}, "parameters": {"type": "array", "items": {"type": "string"}}, "steps": {"type": "array", "minItems": 3, "items": {"type": "string"}}, "substitutes": {"type": "array", "items": {"type": "string"}}, "failure_causes": {"type": "array", "items": {"type": "string"}}, "acceptance": {"type": "array", "items": {"type": "string"}}, "diagram": {"$ref": "#/$defs/diagramData"}}}
  }
}
